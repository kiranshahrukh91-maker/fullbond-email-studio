{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__resend__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/send-guard.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "marketing@knowledge-work-plugins": true,
    "studio-kit@studio-kit": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "studio-kit": {
      "source": {
        "source": "directory",
        "path": "D:\\Projects\\Automation Projects\\studio-kit"
      }
    }
  }
}
